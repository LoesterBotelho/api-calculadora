    {
      "name": "SOMAR",
      "item": [
        {
          "name": "10 + 5 = 15",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const requestData = JSON.parse(pm.request.body.raw);",
                  "const jsonData = pm.response.json();",
                  "",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Content-Type is JSON\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "",
                  "pm.test(\"Response has exactly the expected fields\", function () {",
                  "    pm.expect(jsonData).to.have.all.keys(\"numero1\", \"numero2\", \"operacao\", \"resultado\");",
                  "});",
                  "",
                  "pm.test(\"numero1 is a number\", function () {",
                  "    pm.expect(jsonData.numero1).to.be.a(\"number\");",
                  "});",
                  "",
                  "pm.test(\"numero2 is a number\", function () {",
                  "    pm.expect(jsonData.numero2).to.be.a(\"number\");",
                  "});",
                  "",
                  "pm.test(\"resultado is a number\", function () {",
                  "    pm.expect(jsonData.resultado).to.be.a(\"number\");",
                  "});",
                  "",
                  "pm.test(\"numero1 matches request\", function () {",
                  "    pm.expect(jsonData.numero1).to.eql(requestData.numero1);",
                  "});",
                  "",
                  "pm.test(\"numero2 matches request\", function () {",
                  "    pm.expect(jsonData.numero2).to.eql(requestData.numero2);",
                  "});",
                  "",
                  "pm.test(\"Operation is SOMAR\", function () {",
                  "    pm.expect(jsonData.operacao).to.eql(\"SOMAR\");",
                  "});",
                  "",
                  "pm.test(\"Result is correct\", function () {",
                  "    pm.expect(jsonData.resultado).to.eql(requestData.numero1 + requestData.numero2);",
                  "});",
                  "",
                  "pm.test(\"Result is finite\", function () {",
                  "    pm.expect(Number.isFinite(jsonData.resultado)).to.be.true;",
                  "});",
                  "",
                  "pm.test(\"Response time is less than 2000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});"
                ]
              }
            }
          ],
